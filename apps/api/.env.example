DATABASE_URL=postgresql://picenter:picenter@127.0.0.1:5432/picenter
REDIS_URL=redis://127.0.0.1:6379
PORT=3001
API_PUBLIC_URL=http://127.0.0.1:3001
# Default adapter target is Cloudflare R2. Falls back to local when R2 env is absent.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RUN_WORKER=true
SESSION_SECRET=change-me
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
MICROSOFT_CLIENT_ID=
SMTP_HOST=
